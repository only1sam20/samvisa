# Set the real canonical domain before deploying to production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only email delivery settings. Use a verified Resend sender domain.
RESEND_API_KEY=
CONTACT_EMAIL=
RESEND_FROM_EMAIL=

# Optional future moderation integration; unused in version 1.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
